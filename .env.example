# Salin file ini ke .env untuk test lokal.
# Untuk GitHub Actions, set sebagai repository secrets (Settings > Secrets and variables > Actions).

# === WAJIB ===
# Dapatkan di https://console.groq.com (gratis, tanpa kartu kredit)
GROQ_API_KEY=

# === OPSIONAL: model LLM (default: llama-3.3-70b-versatile) ===
# Alternatif free: llama-3.1-8b-instant, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# === OPSIONAL: kirim email via Resend (https://resend.com, 3000 email/bulan gratis) ===
RESEND_API_KEY=
RESEND_FROM=AI Employee <onboarding@resend.dev>
EMAIL_TO=

# === OPSIONAL: post ke Slack via webhook (https://api.slack.com/messaging/webhooks) ===
SLACK_WEBHOOK_URL=

# === OPSIONAL: logging level (INFO/WARN/ERROR) ===
LOG_LEVEL=INFO
